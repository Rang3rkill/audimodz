{
  "manifest_version": 3,
  "name": "Judi's Wishlist Importer",
  "version": "1.0.0",
  "description": "Import items from Temu and Amazon carts to Judi's Wishlist",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost:5000/*",
    "http://127.0.0.1:5000/*",
    "*://*.temu.com/*",
    "*://*.amazon.com/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.temu.com/*"],
      "js": ["content/temu.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*.amazon.com/*"],
      "js": ["content/amazon.js"],
      "run_at": "document_idle"
    }
  ]
}
